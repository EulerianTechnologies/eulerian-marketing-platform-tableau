{
  "compilerOptions": {
    "target": "es2019",
    "lib": ["ES2021", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "rootDir": "./",
    "sourceMap": true,
    "noEmitOnError": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  }
}
